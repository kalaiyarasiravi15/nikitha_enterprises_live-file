# Sai Techno Solutions SMS (server-side only)
SMS_API_URL=http://sms.saitechnosolutions.net
SMS_TOKEN=
SMS_SENDER=ANYRAT
SMS_CREDIT_TYPE=2
# Required for DLT transactional SMS. Copy the PE_TM_Hash values from the
# approved Sai Techno DLT Templates, one value for each exact message.
SMS_TEMPLATE_HASH_PARAM=PE_TM_Hash
SMS_REQUIRE_TEMPLATE_HASH=true
SMS_TEMPLATE_HASH_OTP=
SMS_TEMPLATE_HASH_ORDER_PLACED=
SMS_TEMPLATE_HASH_ORDER_CONFIRMED=
SMS_TEMPLATE_HASH_ORDER_SHIPPED=
SMS_TEMPLATE_HASH_WELCOME=
# Set these only from Sai Techno Solutions' current API documentation.
# SMS_CREDIT_PATH=
# SMS_DLR_CALLBACK_TOKEN=
